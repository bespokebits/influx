# SwiftPM
.build/
.swiftpm/
/Packages/

# Xcode (projects are generated by XcodeGen and never committed)
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult
Configs/*.local.xcconfig
# Written by XcodeGen from the info: properties in project.yml.
Influx/iOS/Info.plist
Influx/macOS/Info.plist
# Local worktrees.
.claude/worktrees/

# Local environment
.env
.env.*
!.env.example
.DS_Store
# Local build output.
/build/

# The OAuth Worker's wrangler install (server/oauth-worker/package-lock.json pins it).
server/oauth-worker/node_modules/
__pycache__/

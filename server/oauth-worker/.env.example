# Worker secrets, set with `wrangler secret put`, never committed.
# SIGNING_KEY_JWK: the private P-256 JWK, placed by the deploy workflow from the `production` environment.
SIGNING_KEY_JWK=
# APP_ATTEST_KEY: optional, Apple's App Attest fraud metric (ADR 0033), JSON {"keyId","teamId","p8"}, placed by the deploy workflow from the `production` environment, or "off" when that is unset.
APP_ATTEST_KEY=
